.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.DS_Store

# local-only blog drafts + research dossiers (not part of the project)
blogs/

# wrangler (Cloudflare) local state — not part of the project
.wrangler/

# per-run state, written project-local under .fabri/ (see paths.py)
.fabri/
logs/
traces/
src/fabri/traces/

# compiled example Go tool binary
src/fabri/tools/examples/example_go_tool/sum_tool

# setuptools build output
build/

# build artifacts
dist/

# generated wheel payloads (keep the importable package stubs tracked)
src/fabri/examples/agencies/*
!src/fabri/examples/agencies/__init__.py
src/fabri/service/studio_assets/*
!src/fabri/service/studio_assets/__init__.py

# private strategy / decks / signed licenses — never push
decks/
licenses-issued/

# local session summaries / working notes — never push
session-notes/

# local env / secrets (AWS creds, API keys) — never commit
.env*

# bot/OAuth setup output: GitHub App private key (PEM) + captured tokens
secrets/
