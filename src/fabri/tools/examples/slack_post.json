{
  "name": "slack_post",
  "description": "Post a message to a Slack channel, optionally as a threaded reply.",
  "command": ["python3", "slack_post.py"],
  "input_schema": {
    "type": "object",
    "properties": {
      "channel": {
        "type": "string",
        "minLength": 1,
        "description": "Slack channel ID"
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "description": "Message text"
      },
      "thread_ts": {
        "type": "string",
        "minLength": 1,
        "description": "Parent timestamp for a threaded reply"
      },
      "credential": {
        "type": "string",
        "default": "slack:default",
        "description": "Slack bot-token credential reference"
      }
    },
    "required": ["channel", "text"],
    "additionalProperties": false
  },
  "output_schema": {"type": "object"},
  "timeout_s": 10
}
